import { defineConfig, loadEnv } from 'vite';
import react from '@vitejs/plugin-react';

export default defineConfig(({ mode }) => {
  const env = loadEnv(mode, process.cwd(), '');
  
  return {
    // ✅ Vercel deploy এ base '/' লাগবে, './' নয়
    base: '/',
    
    plugins: [react()],
    server: {
      port: 3000,
      strictPort: true,
      host: true
    },
    define: {
      'process.env': env
    },
    build: {
      outDir: 'dist',
      assetsDir: 'assets',
      emptyOutDir: true
    }
  };
});

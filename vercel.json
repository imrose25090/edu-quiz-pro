{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/kitty.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/kitty", "dest": "/api/kitty.js" },
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
